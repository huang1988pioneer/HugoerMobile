<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HugoerMobile.ViewModels"
             x:Class="HugoerMobile.Views.SitesPage"
             x:Name="Root"
             x:DataType="vm:SitesViewModel"
             Title="站台">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="設定" Command="{Binding OpenSettingsCommand}" />
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="*,Auto">

        <RefreshView Grid.Row="0" IsRefreshing="{Binding IsBusy}" Command="{Binding AppearingCommand}">
            <CollectionView ItemsSource="{Binding Sites}"
                             SelectionMode="None"
                             EmptyView="尚未連結任何 Hugo 網站，點下方「新增網站」開始吧！">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="vm:SiteCardViewModel">
                        <SwipeView>
                            <SwipeView.RightItems>
                                <SwipeItems>
                                    <SwipeItem Text="移除"
                                               BackgroundColor="{StaticResource Danger}"
                                               Command="{Binding Source={x:Reference Root}, Path=BindingContext.RemoveSiteCommand}"
                                               CommandParameter="{Binding .}" />
                                </SwipeItems>
                            </SwipeView.RightItems>

                            <Frame Style="{StaticResource CardFrame}">
                                <Frame.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={x:Reference Root}, Path=BindingContext.SelectSiteCommand}"
                                        CommandParameter="{Binding .}" />
                                </Frame.GestureRecognizers>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <Ellipse Grid.Column="0" WidthRequest="12" HeightRequest="12" VerticalOptions="Start" Margin="0,4,0,0">
                                        <Ellipse.Fill>
                                            <SolidColorBrush Color="{Binding IsActive, Converter={StaticResource ActiveDotConverter}}" />
                                        </Ellipse.Fill>
                                    </Ellipse>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Label Text="{Binding FullName}" Style="{StaticResource TitleLabel}" FontSize="17" />
                                        <Label Text="{Binding PagesUrl}" Style="{StaticResource SubtitleLabel}" LineBreakMode="TailTruncation" />
                                        <Label Text="目前作用中" TextColor="{StaticResource Primary}" FontSize="12"
                                               IsVisible="{Binding IsActive}" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Frame>
                        </SwipeView>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>

        <Button Grid.Row="1" Text="＋ 新增網站" Style="{StaticResource PrimaryButton}" Command="{Binding AddSiteCommand}" />
    </Grid>

</ContentPage>
