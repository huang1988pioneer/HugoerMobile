<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HugoerMobile.ViewModels"
             x:Class="HugoerMobile.Views.ConnectSitePage"
             x:DataType="vm:ConnectSiteViewModel"
             Title="新增網站">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="6">

            <Label Text="GitHub Repository" Style="{StaticResource SectionHeaderLabel}" />
            <Entry Placeholder="owner/repo 或 https://github.com/owner/repo"
                   Text="{Binding RepositoryInput}"
                   Keyboard="Url" />

            <Label Text="Personal Access Token" Style="{StaticResource SectionHeaderLabel}" />
            <Entry Placeholder="ghp_xxxxxxxxxxxxxxxxxxxx"
                   Text="{Binding TokenInput}"
                   IsPassword="True" />
            <Label FontSize="12" Style="{StaticResource SubtitleLabel}" Margin="4,0"
                   Text="建議使用 Fine-grained token，權限包含 Contents / Actions / Pages 讀寫。" />

            <Button Text="驗證連線" Style="{StaticResource SecondaryButton}" Margin="0,16,0,0"
                    Command="{Binding VerifyCommand}" />

            <Frame Style="{StaticResource CardFrame}" IsVisible="{Binding IsVerified}" Margin="0,16">
                <Label Text="{Binding VerificationSummary}" />
            </Frame>

            <Label Text="{Binding ErrorMessage}" TextColor="{StaticResource Danger}"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource StringNotEmptyConverter}}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" Color="{StaticResource Primary}" />

            <Button Text="儲存並開始使用" Style="{StaticResource PrimaryButton}"
                    IsEnabled="{Binding IsVerified}"
                    Command="{Binding SaveCommand}" Margin="0,24,0,0" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
