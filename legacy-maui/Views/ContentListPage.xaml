<?xml version="1.0" encoding="UTF-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:HugoerMobile.ViewModels"
             xmlns:models="clr-namespace:HugoerMobile.Models"
             x:Class="HugoerMobile.Views.ContentListPage"
             x:Name="Root"
             x:DataType="vm:ContentListViewModel"
             Title="內容">

    <Grid RowDefinitions="Auto,Auto,*,Auto">

        <VerticalStackLayout Grid.Row="0" Grid.RowSpan="4"
                             IsVisible="{Binding HasActiveSite, Converter={StaticResource InverseBoolConverter}}"
                             VerticalOptions="Center" Padding="32">
            <Label Text="請先在「站台」分頁連結或選擇一個 Hugo 網站" HorizontalTextAlignment="Center" Style="{StaticResource SubtitleLabel}" />
        </VerticalStackLayout>

        <ContentView Grid.Row="0" Grid.RowSpan="4" IsVisible="{Binding HasActiveSite}">
            <Grid RowDefinitions="Auto,Auto,*,Auto">
                <SearchBar Grid.Row="0" Placeholder="搜尋內容" Text="{Binding SearchText}" />

                <HorizontalStackLayout Grid.Row="1" Padding="16,0" Spacing="8">
                    <Button Text="⬆ 上一層" Style="{StaticResource SecondaryButton}" Margin="0" HeightRequest="36"
                            IsEnabled="{Binding CanGoUp}" Command="{Binding GoUpCommand}" />
                    <Label Text="{Binding CurrentPath}" VerticalOptions="Center" Style="{StaticResource SubtitleLabel}" />
                </HorizontalStackLayout>

                <RefreshView Grid.Row="2" IsRefreshing="{Binding IsBusy}" Command="{Binding RefreshCommand}">
                    <CollectionView ItemsSource="{Binding Items}"
                                     EmptyView="此資料夾沒有內容，點下方「新增文章」開始寫作！">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ContentItem">
                                <SwipeView>
                                    <SwipeView.RightItems>
                                        <SwipeItems>
                                            <SwipeItem Text="刪除" BackgroundColor="{StaticResource Danger}"
                                                       Command="{Binding Source={x:Reference Root}, Path=BindingContext.DeleteCommand}"
                                                       CommandParameter="{Binding .}" />
                                        </SwipeItems>
                                    </SwipeView.RightItems>
                                    <Grid Padding="16,12" ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Source={x:Reference Root}, Path=BindingContext.OpenCommand}"
                                                CommandParameter="{Binding .}" />
                                        </Grid.GestureRecognizers>
                                        <Label Grid.Column="0" FontSize="20" VerticalOptions="Center"
                                               Text="📁" IsVisible="{Binding IsDirectory}" />
                                        <Label Grid.Column="0" FontSize="20" VerticalOptions="Center"
                                               Text="📝" IsVisible="{Binding IsMarkdown}" />
                                        <Label Grid.Column="1" Text="{Binding Name}" VerticalOptions="Center" FontSize="15" />
                                    </Grid>
                                </SwipeView>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </RefreshView>

                <Button Grid.Row="3" Text="＋ 新增文章" Style="{StaticResource PrimaryButton}" Command="{Binding AddPostCommand}" />
            </Grid>
        </ContentView>
    </Grid>

</ContentPage>
