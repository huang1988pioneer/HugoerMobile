<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
                     xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- 品牌色：呼應 Hugo 的紫色與桌面版 Avalonia Fluent 深色主題 -->
    <Color x:Key="Primary">#6E56CF</Color>
    <Color x:Key="PrimaryDark">#4C3A9E</Color>
    <Color x:Key="Secondary">#12B886</Color>
    <Color x:Key="Warning">#F59F00</Color>
    <Color x:Key="Danger">#E03131</Color>
    <Color x:Key="Success">#2F9E44</Color>

    <Color x:Key="White">#FFFFFF</Color>
    <Color x:Key="Black">#000000</Color>

    <Color x:Key="LightBackground">#F6F5FA</Color>
    <Color x:Key="LightSurface">#FFFFFF</Color>
    <Color x:Key="LightBorder">#E3E1EC</Color>
    <Color x:Key="LightTextPrimary">#1B1B1F</Color>
    <Color x:Key="LightTextSecondary">#6B6876</Color>

    <Color x:Key="DarkBackground">#141318</Color>
    <Color x:Key="DarkSurface">#201F26</Color>
    <Color x:Key="DarkBorder">#34323C</Color>
    <Color x:Key="DarkTextPrimary">#F2F1F7</Color>
    <Color x:Key="DarkTextSecondary">#A8A4B4</Color>

    <Color x:Key="Gray100">#F5F5F7</Color>
    <Color x:Key="Gray300">#D9D7E0</Color>
    <Color x:Key="Gray500">#8B889A</Color>
    <Color x:Key="Gray900">#26242E</Color>

</ResourceDictionary>
