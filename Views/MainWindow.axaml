<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Hugoer.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="760"
        x:Class="Hugoer.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="1180" Height="760"
        MinWidth="960" MinHeight="640"
        Title="Hugoer — Hugo 一站式工作台"
        Background="#12100E"
        TransparencyLevelHint="None">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Grid ColumnDefinitions="248,*">
        <Border Grid.Column="0" Classes="sidebar" Padding="16,20,14,16">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="12" Margin="6,0,6,22">
                    <Border Classes="mark">
                        <TextBlock Text="H"
                                   FontSize="18"
                                   FontWeight="Bold"
                                   Foreground="#1A120C"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center" Spacing="1">
                        <TextBlock Text="Hugoer" Classes="appTitle"/>
                        <TextBlock Text="網站工作台" Classes="caption"/>
                    </StackPanel>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Classes="siteChip" Padding="12,10" Margin="2,16,2,2">
                    <StackPanel Spacing="4">
                        <TextBlock Text="目前網站" Classes="caption"/>
                        <TextBlock Text="{Binding SiteBanner}"
                                   FontSize="12"
                                   Foreground="#F6F0E8"
                                   TextWrapping="Wrap"
                                   MaxHeight="64"/>
                    </StackPanel>
                </Border>

                <ListBox ItemsSource="{Binding NavItems}"
                         SelectedItem="{Binding SelectedNav}"
                         Classes="navList"
                         Background="Transparent">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItem">
                            <TextBlock Text="{Binding Title}"
                                       FontWeight="SemiBold"
                                       FontSize="15"
                                       Margin="4,6"/>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*">
            <Border Grid.Row="0" Classes="topBar" Padding="28,16">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3" VerticalAlignment="Center">
                        <TextBlock Text="{Binding SelectedNav.Title}" Classes="pageTitle"/>
                        <TextBlock Text="{Binding SelectedNav.Description}"
                                   Classes="muted"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                    <Border Grid.Column="1" Classes="pill" Padding="12,6" Margin="16,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding AppStatus}" Classes="muted" TextWrapping="NoWrap"/>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Row="1" Classes="contentHost">
                <ContentControl Content="{Binding CurrentPage}"/>
            </Border>
        </Grid>
    </Grid>
</Window>
