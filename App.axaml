<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:fluent="using:Avalonia.Themes.Fluent"
             x:Class="Hugoer.App"
             xmlns:local="using:Hugoer"
             RequestedThemeVariant="Dark">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Styles>
        <fluent:FluentTheme>
            <fluent:FluentTheme.Palettes>
                <fluent:ColorPaletteResources x:Key="Dark" Accent="#FFC47A32"/>
                <fluent:ColorPaletteResources x:Key="Light" Accent="#FF9A5B24"/>
            </fluent:FluentTheme.Palettes>
        </fluent:FluentTheme>

        <Style Selector="TextBlock.appTitle">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#F6F0E8"/>
        </Style>

        <Style Selector="TextBlock.pageTitle">
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F6F0E8"/>
        </Style>

        <Style Selector="TextBlock.sectionTitle">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#F6F0E8"/>
        </Style>

        <Style Selector="TextBlock.muted">
            <Setter Property="Opacity" Value="0.78"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#C4B5A6"/>
        </Style>

        <Style Selector="TextBlock.caption">
            <Setter Property="Opacity" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#8E8176"/>
        </Style>

        <Style Selector="TextBlock.mono">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <Style Selector="TextBlock.token">
            <Setter Property="FontFamily" Value="Consolas, Cascadia Mono, monospace"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#F0C48A"/>
        </Style>

        <Style Selector="TextBlock.dirty">
            <Setter Property="Foreground" Value="#E8B15A"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <Style Selector="Border.topBar">
            <Setter Property="Background" Value="#1A1613"/>
            <Setter Property="BorderBrush" Value="#3A312A"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>

        <Style Selector="Border.sidebar">
            <Setter Property="Background" Value="#181410"/>
            <Setter Property="BorderBrush" Value="#3A312A"/>
            <Setter Property="BorderThickness" Value="0,0,1,0"/>
        </Style>

        <Style Selector="Border.contentHost">
            <Setter Property="Background" Value="#12100E"/>
        </Style>

        <Style Selector="Border.card">
            <Setter Property="Background" Value="#221C18"/>
            <Setter Property="BorderBrush" Value="#3A312A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style Selector="Border.featured">
            <Setter Property="Background" Value="#2A2118"/>
            <Setter Property="BorderBrush" Value="#C47A32"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="14"/>
            <Setter Property="Padding" Value="16"/>
        </Style>

        <Style Selector="Border.inset">
            <Setter Property="Background" Value="#181410"/>
            <Setter Property="BorderBrush" Value="#3A312A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
        </Style>

        <Style Selector="Border.panelHeader">
            <Setter Property="Background" Value="#1C1814"/>
            <Setter Property="BorderBrush" Value="#3A312A"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
            <Setter Property="Padding" Value="12,10"/>
        </Style>

        <Style Selector="Border.pill">
            <Setter Property="Background" Value="#2A231C"/>
            <Setter Property="BorderBrush" Value="#3A312A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
        </Style>

        <Style Selector="Border.chip">
            <Setter Property="Background" Value="#3A2A1C"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="8,2"/>
        </Style>

        <Style Selector="Border.siteChip">
            <Setter Property="Background" Value="#241C16"/>
            <Setter Property="BorderBrush" Value="#3A312A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style Selector="Border.mark">
            <Setter Property="Background" Value="#C47A32"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
        </Style>

        <Style Selector="ListBox.navList ListBoxItem">
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style Selector="ListBox.navList ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#3D2C1E"/>
        </Style>

        <Style Selector="ListBox.navList ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A231C"/>
        </Style>

        <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
            <Setter Property="Background" Value="#3D2C1E"/>
        </Style>

        <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#2A231C"/>
        </Style>

        <Style Selector="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style Selector="Button.accent">
            <Setter Property="Background" Value="#C47A32"/>
            <Setter Property="Foreground" Value="#1A120C"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
            <Setter Property="Background" Value="#D4924A"/>
        </Style>

        <Style Selector="TextBox">
            <Setter Property="CornerRadius" Value="10"/>
        </Style>

        <Style Selector="TextBox.codeEditor">
            <Setter Property="AcceptsReturn" Value="True"/>
            <Setter Property="TextWrapping" Value="NoWrap"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Background" Value="#14110E"/>
        </Style>

        <Style Selector="TextBox.logBox">
            <Setter Property="Background" Value="#14110E"/>
            <Setter Property="Padding" Value="10"/>
        </Style>
    </Application.Styles>
</Application>
